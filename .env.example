NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops. Keep 0 for direct local requests; set only to the verified Railway/edge hop count.
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/passion?replicaSet=rs0
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/passion_test?replicaSet=rs0
MONGODB_TEST_DB=passion_test
# Optional, test-only Argon2id settings used by Vitest. Ignored outside NODE_ENV=test.
TEST_ARGON2_MEMORY_COST=4096
TEST_ARGON2_TIME_COST=1
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Production requires Secure __Host- cookies. Use COOKIE_DOMAIN only for non-local development cookies.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Use none only with COOKIE_SECURE=true for direct cross-site Vercel/Railway cookies; lax is preferred behind a same-origin Vercel proxy.
COOKIE_SAME_SITE=lax
# CSRF uses the readable double-submit cookie and X-CSRF-Token header; origins come from CORS_ORIGINS.
CORS_ORIGINS=http://localhost:5173
# Public site origin (not the API origin); used for canonical and sitemap URLs.
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
# Optional Cloudflare R2 configuration. Set all six values together; production requires all six and production-length credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
RECEIPT_SIGNED_URL_SECONDS=300
# Public registration throttles (fixed per-process windows; email keys are SHA-256 hashes only).
# POST /api/v1/public/registrations defaults: 100/IP and 20/normalized-email-hash per 15 minutes.
# GET /api/v1/public/registrations/:reference defaults: 30/IP per 15 minutes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
