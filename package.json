{
  "name": "passion-platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned API backend for Passion Academy",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/check-build.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:focus": "node scripts/run-vitest.mjs run",
    "test:changed": "node scripts/run-test-changed.mjs",
    "test:fast": "node scripts/run-vitest.mjs run --config vitest.fast.config.mts --maxWorkers=1 --no-fileParallelism",
    "test:full": "node scripts/run-test-full.mjs",
    "test:integration": "vitest run src/tests/mongo.integration.test.ts src/tests/models.mongo.integration.test.ts",
    "test:watch": "vitest",
    "check:test-uri": "tsx scripts/check-test-uri.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:schema-sync": "tsx scripts/check-schema-sync.ts",
    "indexes:sync": "tsx src/scripts/syncIndexes.ts",
    "r2:smoke": "tsx src/scripts/r2Smoke.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:public-registration-course": "tsx scripts/seed-public-registration-course.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.5.0",
    "file-type": "16.5.4",
    "helmet": "8.0.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "multer": "2.5.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "sanitize-html": "2.17.0",
    "sharp": "0.35.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/hpp": "0.2.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.13.4",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "eslint": "8.57.1",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "sharp@0.34.4": true,
    "esbuild@0.25.12": true
  }
}
